# ─────────────────────────────────────────────────────────────
# VibeTable backend environment configuration
# Copy this file to `.env` and adjust values for your machine.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ── Database (MySQL 8.0+) ────────────────────────────────────
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=vibetable
DB_PASSWORD=vibetable
DB_DATABASE=vibetable
# The database is self-managing: TypeORM keeps the schema in sync with the
# entity metadata on EVERY boot (entities are the single source of truth —
# no .sql files, no migrations). This switch is accepted for backward
# compatibility but IGNORED — the app always runs with synchronize on, so a
# fresh or wiped database recreates itself automatically at startup.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=900s
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_TTL=30d
JWT_ISSUER=vibetable

# ── Phone OTP ────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_SECONDS=60
# development | twilio (console logs the code in development)
SMS_PROVIDER=development
SMS_FROM=VibeTable
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ── Moderation & Admin bootstrapping ─────────────────────────
# Comma-separated lists. Accounts that register or log in with any of
# these identifiers are promoted to the role IMMEDIATELY (no restart /
# SQL needed); on startup existing accounts are promoted too. There is
# no hard-coded privileged user — without these variables nobody is staff.
#   • admin  → full /api/admin panel (users, shop, games, seasons, analytics)
#   • moderator → reports & moderation dashboard only
# Leave them empty (the default) to keep the boot log quiet. Fill in YOUR
# real email/phone to be promoted to staff automatically the moment that
# account registers or logs in:
#   MODERATION_ADMIN_EMAILS=you@your-domain.com
#   MODERATION_ADMIN_PHONES=+989xxxxxxxxx
MODERATION_ADMIN_EMAILS=
MODERATION_ADMIN_PHONES=
MODERATION_MODERATOR_EMAILS=

# ── Rate limiting ────────────────────────────────────────────
# Global HTTP throttle: max RATE_LIMIT_MAX requests per window (ms) per IP.
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX=120

# ── Development-only convenience admin (NEVER used in production) ──
# When NODE_ENV is not "production", the API auto-creates a ready-to-use
# admin account so the admin panel can be explored without OTP/SQL.
# In production this seeder is a hard no-op. Set DEV_SEED_ADMIN=false to
# disable it even in development. Default credentials:
#   email:    admin@vibetable.local
#   password: Admin123!
DEV_SEED_ADMIN=true
DEV_ADMIN_EMAIL=admin@vibetable.local
DEV_ADMIN_PASSWORD=Admin123!
